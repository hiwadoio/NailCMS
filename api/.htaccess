# В каталоге только 4 публичных эндпоинта — открываем целиком (без Files+FilesMatch: на хостинге это даёт 403)
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
  Allow from all
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Content-Type-Options "nosniff"
</IfModule>
